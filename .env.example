# Copy to .env or set these in PowerShell before starting.
AUTOMATA_HOST=127.0.0.1
AUTOMATA_PORT=8000
AUTOMATA_BROWSER_HEADLESS=false
AUTOMATA_BROWSER_TIMEOUT_MS=15000
AUTOMATA_MAX_RUN_MINUTES=15

# Hosted OpenAI-compatible or local endpoint. Keep the key backend-only.
AUTOMATA_MODEL_ENDPOINT=https://api.openai.com/v1
AUTOMATA_MODEL_NAME=gpt-4o-mini
AUTOMATA_MODEL_TIMEOUT=45
AUTOMATA_MODEL_API_KEY=

# Set true only when the planning endpoint needs a browser snapshot.
AUTOMATA_PLANNER_INSPECT_PAGE=false

